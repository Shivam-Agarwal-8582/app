# Android Emulator Default (10.0.2.2 maps to host machine localhost:8080)
VITE_API_BASE_URL=http://10.0.2.2:8080/api/v1
VITE_WS_URL=ws://10.0.2.2:8080/ws

# Physical Device on same Wi-Fi (replace with your computer's LAN IP, e.g. 192.168.1.50)
# VITE_API_BASE_URL=http://192.168.1.50:8080/api/v1
# VITE_WS_URL=ws://192.168.1.50:8080/ws

# Production Deployed Cloud Backend
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
# VITE_WS_URL=wss://api.yourdomain.com/ws

